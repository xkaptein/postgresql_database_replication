
# PostgreSQL version
POSTGRES_VERSION=19.0-trixie

# Primary database
POSTGRES_DB=your_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Replication account
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator

# Primary host port
POSTGRES_PRIMARY_PORT=5433

# Replica host port
POSTGRES_REPLICA_PORT=5434

# Container timezone
TZ=Asia/Jakarta

# PgBouncer
PGBOUNCER_VERSION=latest
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_REPLICA_PORT=6433
